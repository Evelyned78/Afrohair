{
  "name": "codephenix/wordpress-boilerplate",
  "description": "WordPress boilerplate avec Docker",
  "require": {
    "php": ">=7.4",
    "composer/installers": "^2.0",
    "wpackagist-theme/twentytwentyfive": "1.4",
    "wpackagist-plugin/akismet": "5.6",
    "wpackagist-plugin/jetpack": "15.6",
    "wpackagist-plugin/elementor": "3.35.7",
    "wpackagist-plugin/contact-form-7": "6.1.5",
    "wpackagist-plugin/advanced-custom-fields": "6.7.1",
    "wpackagist-plugin/updraftplus": "1.26.2",
    "wpackagist-plugin/wordpress-seo": "27.1.1"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org",
      "only": [
        "wpackagist-plugin/*",
        "wpackagist-theme/*"
      ]
    }
  ],
  "config": {
    "allow-plugins": {
      "wpackagist-plugin/*": true,
      "wpackagist-theme/*": true,
      "composer/*": true
    }
  },
  "extra": {
    "installer-paths": {
      "wp-content/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "wp-content/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    }
  }
}
