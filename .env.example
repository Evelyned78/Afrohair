# Configuration de l'environnement pour le projet WordPress
# Copier ce fichier en .env et personnaliser les valeurs selon votre configuration

# Adresse IP locale pour accéder au projet
# Utiliser 127.0.0.1 pour localhost ou l'IP de votre machine
IP=127.0.0.1

# Port d'accès du projet WordPress
# Exemples : 8001, 8002, 8003 pour plusieurs projets simultanés
PORT=8001

# Nom de la base de données MySQL
# À personnaliser selon votre projet
DB_NAME=db_name

# Nom d'utilisateur root MySQL
# Utilisé pour l'accès administrateur à phpMyAdmin
DB_USER=db_root_username

# Mot de passe root MySQL
# Utilisé pour l'accès administrateur à phpMyAdmin et WordPress
# À personnaliser avec un mot de passe sécurisé
DB_PASSWORD=db_root_password

# Informations de base pour la configuration de WordPress
SITENAME=Nom du site WordPress
WP_USER=user
WP_PASSWORD=password

# Nom d'hôte pour accéder à votre site WordPress
# Exemple : test-wp.local (doit être configuré dans votre fichier hosts)
HOSTNAME=nom-du-site.local

# URL d'accès à votre site WordPress
WORDPRESS_URL=http://nom-du-site.local

# Nom du groupe de serveur pouvant répondre à la requête
NGINX_ID=nomdusite

# Config proxy pass de nginx
# IMPORTANT : doit être "http://" + la valeur de NGINX_ID ci-dessus (sinon nginx
# essaiera de résoudre ce nom via DNS au lieu d'utiliser l'upstream local, et
# `nginx -t` échouera)
PROXY_URL=http://nomdusite
